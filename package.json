{
  "name": "gloop-pop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "vite build --base=/ && cap sync android",
    "open:android": "cap open android",
    "android:debug": "VITE_QA_HOOK=true npm run build:android && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run build:android && cd android && ./gradlew bundleRelease",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node tools/check-no-hex.mjs",
    "test": "vitest run",
    "gen:palette": "node tools/gen-palette.mjs",
    "gen:icons": "node tools/gen-icons.mjs",
    "audio": "node tools/build-audio.mjs",
    "size": "node tools/check-size.mjs",
    "check": "node tools/gen-palette.mjs --check && npm run typecheck && npm run lint && npm run test && npm run build && npm run size",
    "sim": "vite build --ssr src/core/sim.ts --outDir .sim --emptyOutDir && node tools/sim.mjs",
    "levels": "vite build --ssr src/core/levelGen.ts --outDir .sim --emptyOutDir && node tools/gen-levels.mjs",
    "levels:verify": "npm run levels -- --verify"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/nunito": "5.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
